---
const {
  title,
  siteDescription = "指点字（ゆびてんじ）の入力を練習するためのWebアプリケーションです。",
  ogpDescription,
  ogpImage = "/ogp-default.png",
  isMobileHeader = false,
} = Astro.props;

const siteName = "ゆびテン 指点字学習アプリ";
const pageTitle = title ? `${title}｜${siteName}` : siteName;
const description = ogpDescription || siteDescription;

// canonicalや、og:imageではフルパスが必要なため。生成する
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogpImage, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* 基本メタタグ */}
    <title>{pageTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalURL} />

    {/* OGP（SNSシェア用） */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    {isMobileHeader ? (
      <MobileHeader title={title} />
    ) : (
      <Header title={title} />
    )}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    scroll-padding-top: calc(var(--header-height) + 20px);
  }
</style>
